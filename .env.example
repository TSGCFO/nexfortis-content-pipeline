# nexfortis-content-pipeline — environment variable documentation
#
# This file documents every env var the pipeline reads. It contains NO real values.
# Real values live in:
#   - Render service env vars (production)
#   - Cursor Cloud / local shell exports (development)
#
# When you add a new env var to the codebase, also add it here with a comment
# describing what it does. Treat this file as a contract.

# ----------------------------------------------------------------------------
# Supabase (shared with main NexFortis monorepo — same project, same URL)
# ----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                # used server-side only; never expose
DATABASE_URL=                             # direct Postgres connection string for Drizzle

# ----------------------------------------------------------------------------
# OpenAI (embeddings + Whisper)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=                            # optional
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_WHISPER_MODEL=whisper-1

# ----------------------------------------------------------------------------
# Anthropic (synthesis + question generation)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7-20260101  # update when model id changes

# ----------------------------------------------------------------------------
# Telegram Bot (interview channel + ad-hoc voice capture)
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                         # Hassan's personal chat ID for journalist-mode bot
TELEGRAM_WEBHOOK_SECRET=                  # optional, only if running webhook mode

# ----------------------------------------------------------------------------
# Microsoft Graph (Outlook + Teams capture)
# ----------------------------------------------------------------------------
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REFRESH_TOKEN=                   # offline_access refresh token
MS_GRAPH_USER_PRINCIPAL_NAME=             # Hassan's UPN
MS_GRAPH_MAILBOX_LABELS=#kb,#blog,nexfortis-research  # comma-separated label/keyword filter

# ----------------------------------------------------------------------------
# Sanity (shared with main NexFortis monorepo — same project, same dataset)
# ----------------------------------------------------------------------------
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=                       # token with write scope
SANITY_WEBHOOK_SECRET=                    # for verifying inbound approve webhook

# ----------------------------------------------------------------------------
# SEOwind (drafting)
# ----------------------------------------------------------------------------
SEOWIND_API_KEY=                          # if/when SEOwind publishes API access for our tier
SEOWIND_BRAND_VOICE_ID=                   # the trained Custom Brand Voice profile id
SEOWIND_DEFAULT_PROJECT_ID=

# ----------------------------------------------------------------------------
# Clearscope (independent re-scoring)
# ----------------------------------------------------------------------------
CLEARSCOPE_API_KEY=                       # if available; otherwise pipeline falls back to manual paste

# ----------------------------------------------------------------------------
# Google Indexing API (URL submission on publish)
# ----------------------------------------------------------------------------
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=     # full service-account JSON, base64-encoded

# ----------------------------------------------------------------------------
# Next.js blog (in main monorepo) — revalidate hook
# ----------------------------------------------------------------------------
NEXFORTIS_BLOG_REVALIDATE_URL=
NEXFORTIS_BLOG_REVALIDATE_SECRET=

# ----------------------------------------------------------------------------
# Social distribution
# ----------------------------------------------------------------------------
MISSINGLETTR_API_KEY=                     # optional, MVP can use UI
SOCIALBEE_API_KEY=                        # alternative to Missinglettr

# ----------------------------------------------------------------------------
# GEO tracking (Otterly or Semrush AI Visibility)
# ----------------------------------------------------------------------------
OTTERLY_API_KEY=                          # one of these two; pick per ADR
SEMRUSH_AI_VISIBILITY_API_KEY=

# ----------------------------------------------------------------------------
# Inngest (orchestration)
# ----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=https://api.inngest.com   # override only for self-hosted

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info                             # pino level: trace|debug|info|warn|error|fatal

# ----------------------------------------------------------------------------
# Cowork session ingester (capture-worker / jobs / ingest-claude-cowork)
# ----------------------------------------------------------------------------
# Absolute path to the directory the @ncp/cowork-export laptop CLI writes
# session JSON files into. On Render this is a mounted disk; on local dev
# typically ./data/imports/claude-cowork/. Required; the ingester fails
# fast at startup if missing.
COWORK_IMPORT_DIR=

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000                                  # for any HTTP-listening service (e.g. sanity-bridge webhook)
