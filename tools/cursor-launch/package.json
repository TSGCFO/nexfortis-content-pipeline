{
  "name": "@ncp/cursor-launch",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Reusable launcher for Cursor Cloud Agents targeting the nexfortis-content-pipeline repo. The only thing that changes per run is the prompt.",
  "main": "./dist/index.js",
  "bin": {
    "nfx-cursor-launch": "./dist/cli.js",
    "nfx-cursor-list-models": "./dist/list-models.js"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "start": "node ./dist/cli.js"
  },
  "dependencies": {
    "commander": "12.1.0",
    "undici": "6.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "5.5.3"
  }
}
